{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOneParameter",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter"],
      "Resource": "arn:aws:ssm:eu-north-1:CHANGE-ME-account-id:parameter/2dv705/db_password"
    },
    {
      "Sid": "DecryptIt",
      "Effect": "Allow",
      "Action": ["kms:Decrypt"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.eu-north-1.amazonaws.com"
        }
      }
    }
  ]
}
